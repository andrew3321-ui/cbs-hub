{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "node --experimental-strip-types scripts/verify-fiscal-build.mjs",
    "build": "vinext build",
    "start": "vinext start",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "test": "npm run build && npm run test:unit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler --ignore-pattern work --ignore-pattern outputs",
    "db:generate": "drizzle-kit generate",
    "migrations:verify": "node scripts/verify-migrations.mjs",
    "ci:build": "node scripts/workers-build.mjs",
    "ci:deploy": "node scripts/workers-deploy.mjs",
    "smoke:production": "node scripts/post-deploy-smoke.mjs",
    "security:secrets": "node scripts/check-secrets.mjs",
    "backup:verify": "node scripts/d1-backup-verify.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.10.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
