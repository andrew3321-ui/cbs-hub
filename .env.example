PLATFORM_ADMIN_EMAILS=
# URL canônica pública sem barra final. Não é segredo.
PUBLIC_APP_URL=
# Limite que produz edge.alert.latency nos logs estruturados.
OBSERVABILITY_SLOW_REQUEST_MS=2500
# Segredo exclusivo do Worker para análise defensiva estruturada. Nunca exponha
# esta chave ao navegador, D1, logs ou repositório.
OPENAI_API_KEY=
# Variáveis não secretas e opcionais; estes são os defaults do roteador defensivo.
OPENAI_SECURITY_PRIMARY_MODEL=gpt-5.6-terra
OPENAI_SECURITY_REVIEW_MODEL=gpt-5.6-sol
# Search Console usa conta de serviço somente no servidor. Conceda à conta acesso
# restrito à propriedade e mantenha apenas o escopo webmasters.readonly.
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:cbshub.com.br
PLATFORM_OWNER_TAX_ID=
PLATFORM_OWNER_LEGAL_ADDRESS=
PLATFORM_PRIVACY_CONTACT_EMAIL=
# Obrigatória para rate limit e concessão única do trial por dispositivo.
SECURITY_HASH_KEY=
# Chave mestra (mínimo 32 caracteres) que deriva credenciais HMAC individuais
# para conectores de telemetria. Nunca é persistida no D1 nem enviada ao navegador.
SECURITY_INGEST_SIGNING_KEY=
# Assina manifests enviados ao runner isolado de pentest. Use outra chave dedicada.
SECURITY_RUNNER_SIGNING_KEY=
# Chaves HMAC anteriores, separadas por vírgula, para preservar a antifraude durante rotação.
SECURITY_HASH_KEYS_PREVIOUS=
MERCADO_PAGO_ACCESS_TOKEN=
# Opcional: use somente se o Mercado Pago fornecer a assinatura oficial.
MERCADO_PAGO_WEBHOOK_SECRET=
# Emissão de NFS-e das assinaturas existentes, separada das credenciais de pagamento.
FISCAL_ISSUER_ADAPTER=manual
FISCAL_ISSUER_MUNICIPALITY_CODE=
FISCAL_ISSUER_MUNICIPAL_REGISTRATION=
FISCAL_ISSUER_SERVICE_CODE=
FISCAL_ISSUER_SERVICE_DESCRIPTION=Assinatura mensal CBSHub
# Exclusivos do smoke pós-deploy estrito. Configure somente como build secrets.
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=
SMOKE_STRICT=
